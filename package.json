{
  "name": "medical-booking-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bundle:workers": "esbuild scripts/notification-worker.ts scripts/booking-maintenance-worker.ts scripts/availability-worker.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --tsconfig=tsconfig.json --outdir=dist/workers",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "security:encrypt-pii": "tsx scripts/encrypt-user-pii.ts",
    "notifications:worker": "tsx scripts/notification-worker.ts",
    "bookings:maintenance": "tsx scripts/booking-maintenance-worker.ts",
    "availability:worker": "tsx scripts/availability-worker.ts",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy; fi && npm run build"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.2",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@sentry/nextjs": "^11.7.0",
    "@tanstack/react-query": "^5.104.1",
    "@upstash/redis": "^1.39.0",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "framer-motion": "^14.1.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "logrocket": "^12.4.0",
    "lucide-react": "^1.55.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "pino": "^9.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "8.5.29",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.29",
    "deepmerge-ts": "8.0.0",
    "postcss-selector-parser": "7.1.6"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
