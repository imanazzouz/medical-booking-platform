// Waitlist holds one expiring offer at a time; a partial SQL unique index
// prevents duplicate active subscriptions for the same patient/resource.
model WaitlistEntry {
  id            String           @id @default(uuid()) @db.Uuid
  patientId     String           @map("patient_id") @db.Uuid
  serviceId     String           @map("service_id") @db.Uuid
  doctorId      String?          @map("doctor_id") @db.Uuid
  locationId    String?          @map("location_id") @db.Uuid
  earliestAt    DateTime         @map("earliest_at") @db.Timestamptz(3)
  latestAt      DateTime         @map("latest_at") @db.Timestamptz(3)
  status        WaitlistStatus   @default(WAITING)
  offeredSlotId String?          @map("offered_slot_id") @db.Uuid
  offeredUntil  DateTime?        @map("offered_until") @db.Timestamptz(3)
  appointmentId String?          @unique @map("appointment_id") @db.Uuid
  patient       PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  service       Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  doctor        DoctorProfile?   @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  location      Location?        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  offeredSlot   AppointmentSlot? @relation("WaitlistOfferedSlot", fields: [offeredSlotId], references: [id], onDelete: Restrict)
  appointment   Appointment?     @relation("WaitlistBookedAppointment", fields: [appointmentId], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(3)

  @@index([serviceId, status, earliestAt, latestAt, createdAt])
  @@index([offeredSlotId, status, offeredUntil])
  @@map("waitlist_entries")
}

// Web Push endpoint and secret material are stored as authenticated ciphertext.
model PushSubscription {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  endpointHash         String    @map("endpoint_hash") @db.Char(64)
  endpointCiphertext   Bytes     @map("endpoint_ciphertext") @db.ByteA
  endpointNonce        Bytes     @map("endpoint_nonce") @db.ByteA
  endpointAuthTag      Bytes     @map("endpoint_auth_tag") @db.ByteA
  p256dhCiphertext     Bytes     @map("p256dh_ciphertext") @db.ByteA
  p256dhNonce          Bytes     @map("p256dh_nonce") @db.ByteA
  p256dhAuthTag        Bytes     @map("p256dh_auth_tag") @db.ByteA
  authCiphertext       Bytes     @map("auth_ciphertext") @db.ByteA
  authNonce            Bytes     @map("auth_nonce") @db.ByteA
  authAuthTag          Bytes     @map("auth_auth_tag") @db.ByteA
  encryptionKeyVersion String    @map("encryption_key_version") @db.VarChar(64)
  expirationTime       DateTime? @map("expiration_time") @db.Timestamptz(3)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([userId, endpointHash])
  @@index([userId, deletedAt])
  @@map("push_subscriptions")
}

