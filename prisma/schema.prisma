  appointment    Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient        PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  doctor         DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([doctorId, status, createdAt(sort: Desc)])
  @@index([patientId, createdAt])
  @@map("reviews")
}

model Notification {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  appointmentId        String?             @map("appointment_id") @db.Uuid
  channel              NotificationChannel
  status               NotificationStatus  @default(QUEUED)
  templateKey          String              @map("template_key") @db.VarChar(120)
  dedupeKey            String?             @unique @map("dedupe_key") @db.VarChar(180)
  // Encrypt rendered payloads if they may contain personal or appointment details.
  payloadCiphertext    Bytes?              @map("payload_ciphertext") @db.ByteA
  payloadNonce         Bytes?              @map("payload_nonce") @db.ByteA
  payloadAuthTag       Bytes?              @map("payload_auth_tag") @db.ByteA
  encryptionKeyVersion String?             @map("encryption_key_version") @db.VarChar(64)
  providerMessageId    String?             @map("provider_message_id") @db.VarChar(255)
  attemptCount         Int                 @default(0) @map("attempt_count")
  scheduledAt          DateTime?           @map("scheduled_at") @db.Timestamptz(3)
  sentAt               DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt               DateTime?           @map("read_at") @db.Timestamptz(3)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointment          Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([status, scheduledAt])
  @@index([appointmentId, templateKey, status])
  @@map("notifications")
}

model MedicalRecord {
  id                   String                   @id @default(uuid()) @db.Uuid
  patientId            String                   @map("patient_id") @db.Uuid
  authorDoctorId       String?                  @map("author_doctor_id") @db.Uuid
  appointmentId        String?                  @map("appointment_id") @db.Uuid
  type                 MedicalRecordType
  titleCiphertext      Bytes                    @map("title_ciphertext") @db.ByteA
  titleNonce           Bytes                    @map("title_nonce") @db.ByteA
  titleAuthTag         Bytes                    @map("title_auth_tag") @db.ByteA
  contentCiphertext    Bytes                    @map("content_ciphertext") @db.ByteA
  contentNonce         Bytes                    @map("content_nonce") @db.ByteA
  contentAuthTag       Bytes                    @map("content_auth_tag") @db.ByteA
  encryptionKeyVersion String                   @map("encryption_key_version") @db.VarChar(64)
  encryptedObjectKey   String?                  @map("encrypted_object_key") @db.VarChar(512)
  mimeType             String?                  @map("mime_type") @db.VarChar(120)
  author               DoctorProfile?           @relation("MedicalRecordAuthor", fields: [authorDoctorId], references: [id], onDelete: Restrict)
  patient              PatientProfile           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment          Appointment?             @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  accessLogs           MedicalRecordAccessLog[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([patientId, type, createdAt(sort: Desc)])
  @@index([authorDoctorId, createdAt])
  @@index([appointmentId])
  @@index([deletedAt])
  @@map("medical_records")
}

// Separate access audit is necessary for highly sensitive records; do not soft-delete or mutate
// these rows through normal application flows even though deletedAt exists for policy consistency.
model MedicalRecordAccessLog {
  id          String        @id @default(uuid()) @db.Uuid
  recordId    String        @map("record_id") @db.Uuid
  actorUserId String        @map("actor_user_id") @db.Uuid
  action      String        @db.VarChar(80)
  requestId   String?       @map("request_id") @db.VarChar(100)
  record      MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  actor       User          @relation("MedicalRecordAccessActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([recordId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("medical_record_access_logs")
}

model AuditLog {
  id           String  @id @default(uuid()) @db.Uuid
  actorUserId  String? @map("actor_user_id") @db.Uuid
  action       String  @db.VarChar(120)
  resourceType String  @map("resource_type") @db.VarChar(100)
  resourceId   String? @map("resource_id") @db.VarChar(100)
  requestId    String? @map("request_id") @db.VarChar(100)
  // Store only redacted operational metadata; never include PHI, credentials, or request bodies.
  metadata     Json?
  actor        User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model ConsentRecord {
