// Prisma schema for the medical appointment platform.
// Field-level encryption is implemented in the application/infrastructure layer;
// Prisma itself does not encrypt columns based on schema annotations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  LOCKED
  DISABLED
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PHONE_VERIFICATION
  PASSWORD_RESET
}

enum OrganizationType {
  CLINIC
  RADIOLOGY_CENTER
  LAB_CENTER
}

enum OrganizationStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  STAFF
  DOCTOR
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum DoctorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum ServiceType {
  CONSULTATION
  IMAGING
  LAB_TEST
  OTHER
}

enum AvailabilityExceptionType {
  CLOSED
  OPEN_EXTRA
}

enum BookingMode {
  INSTANT
  APPROVAL_REQUIRED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  EXPIRED
  CANCELLED
}

enum SlotStatus {
  AVAILABLE
  FULL
  BLOCKED
  EXPIRED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum AppointmentStatusChangeReason {
  BOOKED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  PATIENT_CANCELLED
  PROVIDER_CANCELLED
  PROVIDER_APPROVED
  PROVIDER_REJECTED
  ADMIN_ACTION
  COMPLETED_BY_PROVIDER
  MARKED_NO_SHOW
  HOLD_EXPIRED
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  STRIPE
  ADYEN
  PAYPAL
  CASH
  OTHER
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum MedicalRecordType {
  PRESCRIPTION
  LAB_RESULT
  IMAGING_REPORT
  REFERRAL
  CLINICAL_NOTE
  OTHER
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  DATA_PROCESSING
  MARKETING
}

enum ConsentAction {
  GRANTED
  WITHDRAWN
}

model User {
  id                        String     @id @default(uuid()) @db.Uuid
  // email is legacy plaintext during the one-time migration only; new writes use ciphertext + blind index.
  name                      String?
  email                     String?    @unique
  emailLookupHash           String?    @unique @map("email_lookup_hash") @db.VarChar(128)
  emailCiphertext           Bytes?     @map("email_ciphertext") @db.ByteA
  emailNonce                Bytes?     @map("email_nonce") @db.ByteA
  emailAuthTag              Bytes?     @map("email_auth_tag") @db.ByteA
  emailEncryptionKeyVersion String?    @map("email_encryption_key_version") @db.VarChar(64)
  nameCiphertext            Bytes?     @map("name_ciphertext") @db.ByteA
  nameNonce                 Bytes?     @map("name_nonce") @db.ByteA
  nameAuthTag               Bytes?     @map("name_auth_tag") @db.ByteA
  nameEncryptionKeyVersion  String?    @map("name_encryption_key_version") @db.VarChar(64)
  emailVerified             DateTime?  @map("email_verified") @db.Timestamptz(3)
  image                     String?
  role                      UserRole   @default(USER)
  status                    UserStatus @default(PENDING_VERIFICATION)
  passwordHash              String?    @map("password_hash") @db.VarChar(255)
  failedLoginAttempts       Int        @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime?  @map("locked_until") @db.Timestamptz(3)

  // Optional field-level encrypted phone. Store ciphertext/nonce/tag only;
  // use a keyed HMAC blind index for equality lookup if phone search is required.
  phoneCiphertext      Bytes?    @map("phone_ciphertext") @db.ByteA
  phoneNonce           Bytes?    @map("phone_nonce") @db.ByteA
  phoneAuthTag         Bytes?    @map("phone_auth_tag") @db.ByteA
  phoneLookupHash      String?   @unique @map("phone_lookup_hash") @db.VarChar(128)
  phoneVerifiedAt      DateTime? @map("phone_verified_at") @db.Timestamptz(3)
  encryptionKeyVersion String?   @map("encryption_key_version") @db.VarChar(64)

  accounts                Account[]
  sessions                Session[]
  otpChallenges           OtpChallenge[]
  refreshTokens           RefreshToken[]
  patientProfile          PatientProfile?
  doctorProfile           DoctorProfile?
  organizationMemberships OrganizationMember[]
  notifications           Notification[]
  pushSubscriptions       PushSubscription[]
  idempotencyRecords      IdempotencyRecord[]
  notificationPreference  NotificationPreference?
  auditEvents             AuditLog[]                 @relation("AuditActor")
  statusChanges           AppointmentStatusHistory[] @relation("StatusHistoryActor")
  medicalRecordAccesses   MedicalRecordAccessLog[]   @relation("MedicalRecordAccessActor")
  consentRecords          ConsentRecord[]
  apiKeys                 ApiKey[]                   @relation("ApiKeyOwner")
  createdApiKeys          ApiKey[]                   @relation("ApiKeyCreator")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, deletedAt])
  @@index([role, status])
  @@map("users")
}

// Auth.js / NextAuth adapter models. JWT is the configured session strategy;
// Session is retained for adapter compatibility or a future deliberate strategy change.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([provider, providerAccountId])
  @@index([userId, deletedAt])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([userId, expires])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String    @unique
  expires    DateTime  @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@id([identifier, token])
  @@index([expires])
  @@map("verification_tokens")
}

model PatientProfile {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @unique @map("user_id") @db.Uuid
  preferredLocale String @default("ar") @map("preferred_locale") @db.VarChar(10)

  // Authenticated-encryption payloads (for example AES-256-GCM via envelope/KMS keys).
  dateOfBirthCiphertext Bytes?  @map("date_of_birth_ciphertext") @db.ByteA
  dateOfBirthNonce      Bytes?  @map("date_of_birth_nonce") @db.ByteA
  dateOfBirthAuthTag    Bytes?  @map("date_of_birth_auth_tag") @db.ByteA
  genderCiphertext      Bytes?  @map("gender_ciphertext") @db.ByteA
  genderNonce           Bytes?  @map("gender_nonce") @db.ByteA
  genderAuthTag         Bytes?  @map("gender_auth_tag") @db.ByteA
  encryptionKeyVersion  String? @map("encryption_key_version") @db.VarChar(64)

  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]
  medicalRecords  MedicalRecord[]
  reviews         Review[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([deletedAt])
  @@map("patient_profiles")
}

model DoctorProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  userId             String                   @unique @map("user_id") @db.Uuid
  publicSlug         String                   @unique @map("public_slug") @db.VarChar(180)
  publicBiography    String?                  @db.Text
  yearsOfExperience  Int?                     @map("years_of_experience")
  verificationStatus DoctorVerificationStatus @default(PENDING) @map("verification_status")

  // Professional license is sensitive; never store its plaintext in this table.
  licenseNumberCiphertext Bytes?  @map("license_number_ciphertext") @db.ByteA
  licenseNumberNonce      Bytes?  @map("license_number_nonce") @db.ByteA
  licenseNumberAuthTag    Bytes?  @map("license_number_auth_tag") @db.ByteA
  licenseLookupHash       String? @unique @map("license_lookup_hash") @db.VarChar(128)
  encryptionKeyVersion    String? @map("encryption_key_version") @db.VarChar(64)

  user                   User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  specialties            DoctorSpecialty[]
  serviceAssignments     ServiceDoctor[]
  availabilityRules      AvailabilityRule[]
  slots                  AppointmentSlot[]
  waitlistEntries        WaitlistEntry[]
  reviews                Review[]
  authoredMedicalRecords MedicalRecord[]    @relation("MedicalRecordAuthor")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([verificationStatus, deletedAt])
  @@map("doctor_profiles")
}

model Specialty {
  id       String            @id @default(uuid()) @db.Uuid
  code     String            @unique @db.VarChar(80)
  nameAr   String            @map("name_ar") @db.VarChar(180)
  nameEn   String            @map("name_en") @db.VarChar(180)
  isActive Boolean           @default(true) @map("is_active")
  doctors  DoctorSpecialty[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([isActive, deletedAt])
  @@map("specialties")
}

model DoctorSpecialty {
  doctorId    String        @map("doctor_id") @db.Uuid
  specialtyId String        @map("specialty_id") @db.Uuid
  isPrimary   Boolean       @default(false) @map("is_primary")
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  specialty   Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@id([doctorId, specialtyId])
  @@index([specialtyId, deletedAt])
  @@map("doctor_specialties")
}

model Organization {
  id            String             @id @default(uuid()) @db.Uuid
  type          OrganizationType
  slug          String             @unique @db.VarChar(180)
  status        OrganizationStatus @default(DRAFT)
  publicEmail   String?            @map("public_email") @db.VarChar(320)
  publicWebsite String?            @map("public_website") @db.VarChar(2048)
  description   String?            @db.Text

  // Private operational phone stored as an authenticated-encryption payload.
  phoneCiphertext      Bytes?  @map("phone_ciphertext") @db.ByteA
  phoneNonce           Bytes?  @map("phone_nonce") @db.ByteA
  phoneAuthTag         Bytes?  @map("phone_auth_tag") @db.ByteA
  phoneLookupHash      String? @unique @map("phone_lookup_hash") @db.VarChar(128)
  encryptionKeyVersion String? @map("encryption_key_version") @db.VarChar(64)

  clinicProfile    ClinicProfile?
  radiologyProfile RadiologyCenterProfile?
  labProfile       LabCenterProfile?
  translations     OrganizationTranslation[]
  locations        Location[]
  services         Service[]
  members          OrganizationMember[]
  reviews          Review[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([type, status, deletedAt])
  @@map("organizations")
}

// Type-specific details remain separate while the common provider identity is normalized.
model ClinicProfile {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @unique @map("organization_id") @db.Uuid
  licenseCiphertext Bytes?       @map("license_ciphertext") @db.ByteA
  licenseNonce      Bytes?       @map("license_nonce") @db.ByteA
  licenseAuthTag    Bytes?       @map("license_auth_tag") @db.ByteA
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("clinic_profiles")
}

model RadiologyCenterProfile {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @unique @map("organization_id") @db.Uuid
  licenseCiphertext Bytes?       @map("license_ciphertext") @db.ByteA
  licenseNonce      Bytes?       @map("license_nonce") @db.ByteA
  licenseAuthTag    Bytes?       @map("license_auth_tag") @db.ByteA
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("radiology_center_profiles")
}

model LabCenterProfile {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @unique @map("organization_id") @db.Uuid
  licenseCiphertext Bytes?       @map("license_ciphertext") @db.ByteA
  licenseNonce      Bytes?       @map("license_nonce") @db.ByteA
  licenseAuthTag    Bytes?       @map("license_auth_tag") @db.ByteA
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@map("lab_center_profiles")
}

model OrganizationTranslation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  locale         String       @db.VarChar(10)
  name           String       @db.VarChar(200)
  description    String?      @db.Text
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([organizationId, locale])
  @@index([locale, deletedAt])
  @@map("organization_translations")
}

model OrganizationMember {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  role           OrganizationMemberRole
  status         MembershipStatus       @default(INVITED)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([organizationId, userId])
  @@index([userId, status, deletedAt])
  @@index([organizationId, role, status])
  @@map("organization_members")
}

model Location {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  name              String             @db.VarChar(180)
  addressLine       String             @map("address_line") @db.VarChar(300)
  city              String             @db.VarChar(120)
  region            String?            @db.VarChar(120)
  postalCode        String?            @map("postal_code") @db.VarChar(32)
  countryCode       String             @default("DZ") @map("country_code") @db.Char(2)
  timezone          String             @default("Africa/Algiers") @db.VarChar(64)
  latitude          Decimal?           @db.Decimal(9, 6)
  longitude         Decimal?           @db.Decimal(9, 6)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  serviceLinks      ServiceLocation[]
  availabilityRules AvailabilityRule[]
  slots             AppointmentSlot[]
  waitlistEntries   WaitlistEntry[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([city, countryCode, deletedAt])
  @@index([organizationId, deletedAt])
  @@map("locations")
}

model Service {
  id                        String               @id @default(uuid()) @db.Uuid
  organizationId            String               @map("organization_id") @db.Uuid
  type                      ServiceType
  code                      String?              @db.VarChar(100)
  durationMinutes           Int                  @map("duration_minutes")
  price                     Decimal              @db.Decimal(12, 2)
  currency                  String               @default("DZD") @db.Char(3)
  isActive                  Boolean              @default(false) @map("is_active")
  requiresDoctor            Boolean              @default(false) @map("requires_doctor")
  bookingMode               BookingMode          @default(INSTANT) @map("booking_mode")
  approvalHoldMinutes       Int                  @default(15) @map("approval_hold_minutes")
  cancellationNoticeMinutes Int                  @default(0) @map("cancellation_notice_minutes")
  preparationNotes          String?              @map("preparation_notes") @db.Text
  organization              Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  translations              ServiceTranslation[]
  doctorAssignments         ServiceDoctor[]
  locations                 ServiceLocation[]
  availabilityRules         AvailabilityRule[]
  slots                     AppointmentSlot[]
  waitlistEntries           WaitlistEntry[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([organizationId, code])
  @@index([organizationId, type, isActive, deletedAt])
  @@index([type, isActive])
  @@map("services")
}

model ServiceTranslation {
  id               String  @id @default(uuid()) @db.Uuid
  serviceId        String  @map("service_id") @db.Uuid
  locale           String  @db.VarChar(10)
  name             String  @db.VarChar(200)
  description      String? @db.Text
  preparationNotes String? @map("preparation_notes") @db.Text
  service          Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@unique([serviceId, locale])
  @@index([locale, deletedAt])
  @@map("service_translations")
}

model ServiceDoctor {
  serviceId String        @map("service_id") @db.Uuid
  doctorId  String        @map("doctor_id") @db.Uuid
  service   Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@id([serviceId, doctorId])
  @@index([doctorId, deletedAt])
  @@map("service_doctors")
}

model ServiceLocation {
  serviceId  String   @map("service_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@id([serviceId, locationId])
  @@index([locationId, deletedAt])
  @@map("service_locations")
}

model AvailabilityRule {
  id         String                  @id @default(uuid()) @db.Uuid
  serviceId  String                  @map("service_id") @db.Uuid
  doctorId   String?                 @map("doctor_id") @db.Uuid
  locationId String?                 @map("location_id") @db.Uuid
  weekday    Int // ISO-8601: Monday=1 through Sunday=7; add DB CHECK.
  startTime  DateTime                @map("start_time") @db.Time(0)
  endTime    DateTime                @map("end_time") @db.Time(0)
  timezone   String                  @default("Africa/Algiers") @db.VarChar(64)
  validFrom  DateTime?               @map("valid_from") @db.Date
  validUntil DateTime?               @map("valid_until") @db.Date
  isActive   Boolean                 @default(true) @map("is_active")
  service    Service                 @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  doctor     DoctorProfile?          @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  location   Location?               @relation(fields: [locationId], references: [id], onDelete: Restrict)
  exceptions AvailabilityException[]
  slots      AppointmentSlot[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([serviceId, weekday, isActive, deletedAt])
  @@index([doctorId, weekday, isActive])
  @@index([locationId, weekday, isActive])
  @@map("availability_rules")
}

model AvailabilityException {
  id             String                    @id @default(uuid()) @db.Uuid
  ruleId         String                    @map("rule_id") @db.Uuid
  date           DateTime                  @db.Date
  type           AvailabilityExceptionType
  startTime      DateTime?                 @map("start_time") @db.Time(0)
  endTime        DateTime?                 @map("end_time") @db.Time(0)
  internalReason String?                   @map("internal_reason") @db.VarChar(300)
  rule           AvailabilityRule          @relation(fields: [ruleId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
