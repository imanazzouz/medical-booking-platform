model Appointment {
  id                    String                     @id @default(uuid()) @db.Uuid
  patientId             String                     @map("patient_id") @db.Uuid
  slotId                String                     @map("slot_id") @db.Uuid
  bookingReference      String                     @unique @map("booking_reference") @db.VarChar(32)
  idempotencyKeyHash    String?                    @unique @map("idempotency_key_hash") @db.VarChar(64)
  requestHash           String?                    @map("request_hash") @db.VarChar(64)
  status                AppointmentStatus          @default(PENDING)
  patientNoteCiphertext Bytes?                     @map("patient_note_ciphertext") @db.ByteA
  patientNoteNonce      Bytes?                     @map("patient_note_nonce") @db.ByteA
  patientNoteAuthTag    Bytes?                     @map("patient_note_auth_tag") @db.ByteA
  encryptionKeyVersion  String?                    @map("encryption_key_version") @db.VarChar(64)
  confirmedAt           DateTime?                  @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt           DateTime?                  @map("cancelled_at") @db.Timestamptz(3)
  holdExpiresAt         DateTime?                  @map("hold_expires_at") @db.Timestamptz(3)
  patient               PatientProfile             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  waitlistEntry         WaitlistEntry?             @relation("WaitlistBookedAppointment")
  slot                  AppointmentSlot            @relation(fields: [slotId], references: [id], onDelete: Restrict)
  statusHistory         AppointmentStatusHistory[]
  payments              Payment[]
  review                Review?
  medicalRecords        MedicalRecord[]
  notifications         Notification[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([patientId, status, createdAt(sort: Desc)])
  @@index([slotId, status])
  @@index([status, createdAt])
  @@map("appointments")
}

model AppointmentStatusHistory {
