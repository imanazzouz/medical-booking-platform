  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([appointmentId, status])
  @@index([status, createdAt])
  @@map("payments")
}

model Review {
  id             String         @id @default(uuid()) @db.Uuid
  appointmentId  String         @unique @map("appointment_id") @db.Uuid
