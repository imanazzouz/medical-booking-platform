# Local development only. Copy to .env and replace all placeholders. Never commit populated secrets.
POSTGRES_DB=medical_booking
POSTGRES_USER=medical
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://medical:replace-with-local-password@localhost:5432/medical_booking?schema=public
# Neon/Vercel: pooled URL above for runtime; direct/unpooled URL below for Prisma migrations.
DATABASE_URL_UNPOOLED=postgresql://medical:replace-with-local-password@localhost:5432/medical_booking?schema=public
APP_ORIGIN=http://localhost:3000
DEPLOYMENT_ENV=development
NEXT_PUBLIC_DEPLOYMENT_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SEO_INDEXING_ENABLED=false
NEXT_PUBLIC_USE_MOCK_DATA=true

# Generate unique values; do not reuse these between development, staging, and production.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_SECRET=replace-with-a-different-32-byte-secret
OTP_PEPPER=replace-with-a-separate-random-secret
LOOKUP_HMAC_SECRET=replace-with-another-random-secret
CSRF_SECRET=replace-with-a-dedicated-random-secret
API_KEY_PEPPER=replace-with-a-dedicated-random-secret
FIELD_ENCRYPTION_KEY=base64-encoded-exactly-32-random-bytes
FIELD_ENCRYPTION_ACTIVE_KEY_VERSION=v1
# Optional: add versioned keys without removing old decrypt keys, e.g. {"v1":"...","v2":"..."}
FIELD_ENCRYPTION_KEYS_JSON=
REDIS_URL=redis://localhost:6379

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=local-user
SMTP_PASSWORD=local-password
SMTP_FROM=no-reply@example.test
SMS_GATEWAY_URL=https://sms-gateway.example/api/messages
SMS_GATEWAY_TOKEN=replace-me
# Generate with `npx web-push generate-vapid-keys`; required to enable Web Push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Observability: Sentry error capture is enabled only when DSNs are configured; all user/request data is scrubbed.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Set SENTRY_ORG / SENTRY_PROJECT as GitHub Environment variables.
# Store SENTRY_AUTH_TOKEN only as a GitHub Environment secret for private source-map upload; never in runtime .env.
# LogRocket stays off unless a BAA/legal approval is in place, an app ID is set, and the browser explicitly opts in.
NEXT_PUBLIC_LOGROCKET_APP_ID=
NEXT_PUBLIC_LOGROCKET_BAA_APPROVED=false

# MEDIA_CDN_ORIGIN is a public build variable, configured in GitHub Environment vars and baked into the image.
# Keep it HTTPS-only; do not put PHI or private records on this CDN.

# Production deployment metadata. Configure separately in GitHub environments and on the host.
PUBLIC_HOST=
ACME_EMAIL=

# S3-compatible encrypted backup destination; keep the private age key outside this system and outside the backup bucket.
BACKUP_REMOTE=s3:medical-booking-backups/production
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=35
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=300
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=Other
RCLONE_CONFIG_S3_ENDPOINT=
RCLONE_CONFIG_S3_REGION=
RCLONE_CONFIG_S3_ACCESS_KEY_ID=
RCLONE_CONFIG_S3_SECRET_ACCESS_KEY=
